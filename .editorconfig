# Editor settings shared by the Progeni Bench repository.
# Runtime files are served as-is, so keep formatting consistent with the build.
root = true

[*]
charset = utf-8
end_of_line = unset
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
