/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.clarity.ms https://*.clarity.ms; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://c.bing.com https://*.clarity.ms; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' https://tessdata.projectnaptha.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none';
  Link: </llms.txt>; rel="alternate"; type="text/plain", </llms-full.txt>; rel="alternate"; type="text/plain"

# The microphone is enabled only on the audio toolkit routes, where the voice
# recorder and mic check need it. Every other path keeps microphone=().
/audio/*
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/vendor/ffmpeg/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate
